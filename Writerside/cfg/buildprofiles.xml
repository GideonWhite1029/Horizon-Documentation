<?xml version="1.0" encoding="UTF-8"?>
<buildprofiles xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/build-profiles.xsd"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <build-profile instance="horizondoc">
        <variables>
            <web-root>https://gideonwhite1029.github.io/Horizon-Documentation/</web-root>
            <download-page>https://github.com/GideonWhite1029/Horizon/releases/latest</download-page>
            <download-title>Download Horizon</download-title>
            <showDownloadButton>true</showDownloadButton>
            <custom-favicons>horizon.svg</custom-favicons>
            <header-logo>horizon.svg</header-logo>
            <product-web-url>https://github.com/GideonWhite1029/Horizon</product-web-url>
            <primary-color>purple</primary-color>
            <color-preset>vivid</color-preset>
        </variables>
        <footer>
            <social type="email" href="gideonwhite1029@gmail.com">Email</social>
            <link href="https://boosty.to/gideonwhite1029">Boosty</link>
            <link href="https://tapy.me/gideonwhite1029">Other Links</link>
        </footer>
    </build-profile>

</buildprofiles>
